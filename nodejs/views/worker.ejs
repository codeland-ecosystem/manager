<%- include('top') %>
<script type="text/javascript">
	// Require login to see this page.
	app.auth.forceLogin()
</script>

<style type="text/css">
	div.card-body.jq-repeat-workerInfomation > ul > li.list-group-item{
		padding: 2px;
	}

	.w3_tooltip {
	  position: relative;
	  display: inline-block;
/*	  border-bottom: 1px dotted black;*/
	}

