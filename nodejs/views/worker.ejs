</style>
<script type="text/javascript">

	function formatBytes(bytes, decimals = 2) {
	    if (!+bytes) return '0 Bytes'

	    const k = 1024
	    const dm = decimals < 0 ? 0 : decimals
	    const sizes = ['Bytes', 'KiB', 'MiB', 'GiB', 'TiB', 'PiB', 'EiB', 'ZiB', 'YiB']

	    const i = Math.floor(Math.log(bytes) / Math.log(k))

	    return `${parseFloat((bytes / Math.pow(k, i)).toFixed(dm))} ${sizes[i]}`
	}

	function parseMemory(memory){
		
		memory.cahcedAndBuffer = memory.cached + memory.buffers
		memory.percentCahcedAndBuffer = (memory.cahcedAndBuffer/memory.total)*100

		memory.cahcedAndBuffer2 = memory.available - memory.free
		memory.percentCahcedAndBuffer2 = (memory.cahcedAndBuffer2/memory.total)*100


		for(let [key, value] of Object.entries(memory)){

			if(key.includes('percent')){
				memory[`${key}Floor`] = Math.floor(value);
				continue;
			}
			memory[key] = formatBytes(value)
		}

		return memory;
	}

	function parseDf(df){
		return {
			filesystem: df.filesystem,
			used: formatBytes(df.used),
			total: formatBytes(df.total),
			available: formatBytes(df.available),
			percentUsed: df['use%'],
		}
	}

	function parseWorker(worker){
		 return {
		 	...worker,
			startedAgo: moment(worker.startedAt).fromNow(),
			pubkey: worker.userHasKey ? '(pubkey)' : undefined,
		 }
	}

	let runnerStatusMap = {
		available: 'primary',
		inUse: 'warning',
		complete: 'warning',
		execute: 'success',
		error: 'danger',
		free: 'secondary',
	}


	function runnerStatus(runner, status){
		if(!runnerStatusMap[status]) status = 'error';
		let $el = $(`#runner-${runner}`);
		// console.log('runnerStatus', )
		$el.removeClass (function (index, className) {
		    return (className.match (/(^|\s)list-group-item-\S+/g) || []).join(' ');
		});

		$el.addClass(`list-group-item-${runnerStatusMap[status]}`)
	}

	$(document).ready(function(){

		//   // set up animation for adding to taks list
		// $.scope.runnerAvailable.__put = function(){
		//     this.slideDown( 'slow' );
		// };

		// // set up animation for removing taks from list
		// $.scope.runnerAvailable.__take = function(){
		// 	this.slideUp( 'slow', function(){
		// 		this.remove();
		// 	});
		// };

		// // set up animation for adding to taks list
		// $.scope.runnerInUse.__put = function(){
		//     this.fadeIn( 'slow' );
		// };

		// // set up animation for removing taks from list
		// $.scope.runnerInUse.__take = function(){
		// 	this.fadeOut( 'slow', function(){
		// 		this.remove();
		// 	});
		// };

		app.api.get('runner', function(err, data){
			for(runner of data.runners){
				// Persistent runners already have their own panel below (loaded
				// from the registry); skip them here so they don't also show up
				// as if they were idle/in-use pool capacity.
				if(runner.persistent) continue;
				if(runner.lastStatus.status !== 'available'){
					$.scope.runnerInUse.push({...runner, ...runner.lastStatus})
				}else{
					$.scope.runnerAvailable.push({...runner, ...runner.lastStatus})
				}
				runnerStatus(runner.name, runner.lastStatus.status)
			}
		});

		app.api.get('worker', (err, data)=>{
			$.scope.workerInfomation.update({
				oven: data.oven,
				df: parseDf(data.df),
				memory: parseMemory(data.memory),
				worker: parseWorker(data.worker),
			});
		});

		app.subscribe('cl:worker:init', (data, topid)=>{
			console.log('sub init')
			$.scope.workerInfomation.update({worker:parseWorker(data)})
			let $el = $('#workerStatusCard')
			$el.addClass('alert-success')
			$.scope.errors.splice(0, $.scope.errors.length);
			setTimeout($el => $el.removeClass('alert alert-success'), 10000, $el);
		});

		app.socket.on("disconnect", () => {
			console.log('dis1')
			let $el = $('#workerStatusCard')
			$el.addClass('alert-danger')
			$('#workerStatus').hide();
		});


		app.socket.io.on("reconnect", () => {
		  	let $el = $('#workerStatusCard')
			$el.removeClass('alert-danger')
			$('#workerStatus').show();
		});


		app.subscribe('cl:worker:runner:status:available', function(data, topic){
			// console.log(topic, data)
			// Persistent runners transition to "available" once at creation --
			// they belong in the Persistent Runners panel, not this pool list.
			if(data.persistent) return;
			$.scope.runnerAvailable.push({name: data.runner})
		});

		app.subscribe('cl:worker:runner:status:inUse', function(data, topic){
			// console.log(topic)
			if(data.persistent) return;
			$.scope.runnerAvailable.splice(data.runner, 1)
			// console.log('inUse', data.runner, topic.split(':')[4])
			if($.scope.runnerInUse.indexOf(data.runner) === -1) $.scope.runnerInUse.push({name: data.runner})
			runnerStatus(data.runner, topic.split(':')[4])
		});

		app.subscribe('cl:worker:runner:status:free:success', function(data, topic){
			// console.log('free', topic)
			setTimeout((data, topic)=>{
				$.scope.runnerInUse.splice(data.runner, 1)
				$.scope.runnerAvailable.splice(data.runner, 1)
			}, 30000, data, topic)
		});


		// app.subscribe('cl:worker:runner:status:complete', function(data, topic){
		// 	$.scope.runnerInUse.update(data.runner, data);
		// });

		app.subscribe(/^cl:worker:runner:status:/, function(data, topic){
			// console.log('regex', topic)
			if(data.persistent) return;
			topic = topic.split(':')

			if(data.duration){
				durationHuman = moment.duration(data.duration).humanize();
				data.info = `Execution took ${durationHuman} <i>(${data.duration}ms)</i>`
			}

			if(!data.lastStatus) data.lastStatus = {};

			data.lastStatus.status = topic[4];

			$.scope.runnerInUse.update(data.runner, data)

			setTimeout((data, topic)=>{
				runnerStatus(data.runner, data.error || topic[4])
			}, 100, data, topic)

		})

		app.subscribe(/^cl:worker:oven/, function(data, topic){
			// console.log(topic, data)
			$.scope.workerInfomation.update({oven:{
				...data,
				status: topic.split(':')[4]
			}})
		});

		app.subscribe(/error/, (data, topic)=>{
			$.scope.errors.splice(0,0,{topic, data, error: JSON.stringify(data.error)});
			if($.scope.errors.length > 10) $.scope.errors.pop()
		})

		app.subscribe('cl:worker:memory', function(data, topic){
			// console.log(topic, data)
			$.scope.workerInfomation.update({memory: parseMemory(data)});
		});

		app.subscribe('cl:worker:df', function(data, topic){
			console.log('sub df',
				$.scope.workerInfomation.update({df: parseDf(data)})
			)
		});

		// Load the persistent-runner registry.
		app.codeland.listRegistry(function(err, data){
			if(err) return console.log('registry error', err, data);
			for(const r of (data.runners || [])){
				$.scope.persistentRunners.push(r);
			}
		});

		// Load recent job history from the metrics endpoint.
		app.api.get('worker/metrics', function(err, data){
			if(err) return console.log('metrics error', err, data);
			for(const h of (data.history || [])){
				$.scope.runnerHistory.push({
					...h,
					whenAgo: moment(h.when).fromNow(),
					okLabel: h.ok ? 'success' : 'danger',
				});
			}
		});

		setInterval(()=>{
			$('.momentUpdate').each((idx,el)=>{
				try{
			    	let txt = moment($(el).data('moment-time')).fromNow()
			    	$.scope.workerInfomation.update({worker: {startedAgo: txt}})
				}catch{}
			})
		}, 30000, )

	});

	function createPersistent(){
		app.util.promptModal({title: 'Runner name'}, function(name){
			if(!name) return;
			app.util.promptModal({title: 'Memory limit', placeholder: 'e.g. 512M, 1G -- optional, leave blank for none'}, function(memLimit){
				memLimit = memLimit || undefined;
				app.util.actionMessage('Creating persistent runner...', $('#persistent-card .actionMessage'), 'warning');
				app.codeland.makePersistent({name, memLimit}, function(err, data){
					if(err) return app.util.actionMessage(`Failed: <b>${(data&&data.message)||err}</b>`, $('#persistent-card .actionMessage'), 'danger');
					app.util.actionMessage('', $('#persistent-card .actionMessage'));
					$.scope.persistentRunners.push({name: data.runner, worker: data.worker, status: 'running'});
				});
			});
		});
	}

	function stopPersistent(name){
		app.util.confirmModal(`Stop persistent runner ${name}? (keeps NFS state)`, function(){
			app.codeland.stopPersistent(name, function(err, data){
				if(err) return app.util.actionMessage(`Failed: <b>${(data&&data.message)||err}</b>`, $('#persistent-card .actionMessage'), 'danger');
				$.scope.persistentRunners.update(name, {status: 'stopped'});
			});
		});
	}

	function migratePersistent(name){
		app.util.promptModal({title: 'Destination worker host'}, function(worker){
			if(!worker) return;
			app.codeland.migratePersistent(name, worker, function(err, data){
				if(err) return app.util.actionMessage(`Failed: <b>${(data&&data.message)||err}</b>`, $('#persistent-card .actionMessage'), 'danger');
				$.scope.persistentRunners.update(name, {worker: data.worker});
				app.util.actionMessage(`Migrated ${name} to ${data.worker}`, $('#persistent-card .actionMessage'), 'success');
			});
		});
	}

	function ovenPause(){
		app.api.post('worker/oven/pause', {}, function(err, data){
			if(err) return app.util.actionMessage(`Failed: <b>${(data&&data.message)||err}</b>`, $('#workerStatusCard .actionMessage'), 'danger');
			app.util.actionMessage('Oven paused', $('#workerStatusCard .actionMessage'), 'success');
		});
	}

	function ovenResume(){
		app.api.post('worker/oven/resume', {}, function(err, data){
			if(err) return app.util.actionMessage(`Failed: <b>${(data&&data.message)||err}</b>`, $('#workerStatusCard .actionMessage'), 'danger');
			app.util.actionMessage('Oven resumed', $('#workerStatusCard .actionMessage'), 'success');
		});
	}

	function ovenSetMin(){
		app.util.promptModal({title: 'Standby runner target', placeholder: 'minAvailableRunners'}, function(n){
			if(!n) return;
			app.api.post('worker/oven/min', {min: Number(n)}, function(err, data){
				if(err) return app.util.actionMessage(`Failed: <b>${(data&&data.message)||err}</b>`, $('#workerStatusCard .actionMessage'), 'danger');
				app.util.actionMessage(`Standby target set to ${data.minAvailableRunners}`, $('#workerStatusCard .actionMessage'), 'success');
			});
		});
	}

	function ovenDrain(){
		app.util.confirmModal('Drain all idle runners? (stops cooking and frees the pool)', function(){
			app.api.post('worker/oven/drain', {}, function(err, data){
				if(err) return app.util.actionMessage(`Failed: <b>${(data&&data.message)||err}</b>`, $('#workerStatusCard .actionMessage'), 'danger');
				app.util.actionMessage(`Drained ${data.freed} idle runners`, $('#workerStatusCard .actionMessage'), 'success');
			});
		});
	}
</script>
<div class="row" style="display:none">

	<div class="col-md-4">
		<div id="workerStatusCard" class="card shadow-lg">
			<div class="card-header">
				<div id="workerStatus" class="float-right spinner-grow spinner-grow-sm text-success" role="status">
				  <span class="sr-only">Loading...</span>
				</div>
				<i class="fa-solid fa-server"></i>
				Worker Information

			</div>
			<div class="card-header actionMessage" style="display:none"></div>
			<div class="card-body" jq-repeat="workerInfomation">

				<div id="clWokerInformation" class="card-text">
					<span> Environment: <b>{{worker.environment}}</b> </span> <br/>
					<span> Host: <b>{{worker.location}}</b> </span> <br/>
					<span> Host user: <b>{{worker.user}}</b> <i>{{worker.pubkey}}</i> </span> <br/>
					<span class="w3_tooltip">
						Manger service started <b class="momentUpdate" data-moment-time="{{worker.startedAt}}">{{worker.startedAgo}}</b> 
						<span class="w3_tooltiptext">{{worker.startedAt}}</span>
					</span>
				</div>

				<hr />

				<h4 class="card-title">Memory</h4>
				<ul class="list-group list-group-flush">
					<li class="list-group-item list-group-item-primary">
						 Total: <b>{{memory.total}}</b> 
					</li>
					<li class="list-group-item list-group-item-danger">
						 Used: <b >{{memory.used}}</b> <i>{{memory.percentUsedFloor}}%</i> 
					</li>
					<li class="list-group-item list-group-item-secondary">
						 Buffer+Cache: <b>{{memory.cahcedAndBuffer2}}</b> <i>{{memory.percentCahcedAndBuffer2Floor}}%</i>
					</li>
					<li class="list-group-item list-group-item-success">
						 Free: <b>{{memory.free}}</b> <i>{{memory.percentFreeFloor}}%</i>
					</li>
				</ul>

				<br />
				<div class="progress">
				  <div class="progress-bar bg-danger" role="progressbar" style="width: {{memory.percentUsed}}%" aria-valuenow="{{memory.percentUsed}}" aria-valuemin="0" aria-valuemax="100"></div>
				  <div class="progress-bar bg-secondary" role="progressbar" style="width: {{memory.percentCahcedAndBuffer2}}%" aria-valuenow="{{memory.percentCahcedAndBuffer2}}" aria-valuemin="0" aria-valuemax="100"></div>
				  <div class="progress-bar bg-success" role="progressbar" style="width: {{memory.percentFree}}%" aria-valuenow="{{memory.percentFree}}" aria-valuemin="0" aria-valuemax="100"></div>
				</div>
					
				<hr />

				<h4 class="card-title">Disk /</h4>
				<p class="card-text">
					<span> Total: <b>{{df.total}}</b> </span> <br/>
					<span> Used: <b>{{df.used}}</b> </span> <br/>
					<div class="progress">
					  <div class="progress-bar" role="progressbar"
					  	style="width: {{df.percentUsed}}%;"
					  	aria-valuenow="{{df.percentUsed}}" aria-valuemin="0"
					  	aria-valuemax="100">
					  		{{df.percentUsed}}%
					  </div>
					</div>
				</p>

				<hr />

				<h4 class="card-title">Runner Oven</h4>
				<p class="card-text">
					<span> Cooking: <b>{{oven.cooking}}</b> </span> <br/>
					<span> Available: <b>{{oven.count}}</b> </span> <br/>
					<span> Status: <b>{{oven.status}}</b> </span> <br/>
					<span> Message: <b>{{oven.message}}</b> </span> <br/>
				</p>

				<div class="btn-group btn-group-sm mb-2">
					<button class="btn btn-outline-warning btn-sm" onclick="ovenPause()" title="Pause cooking">
						<i class="fa-solid fa-pause"></i> Pause
					</button>
					<button class="btn btn-outline-success btn-sm" onclick="ovenResume()" title="Resume cooking">
						<i class="fa-solid fa-play"></i> Resume
					</button>
					<button class="btn btn-outline-info btn-sm" onclick="ovenSetMin()" title="Set standby target">
						<i class="fa-solid fa-sliders"></i> Min
					</button>
					<button class="btn btn-outline-danger btn-sm" onclick="ovenDrain()" title="Drain idle runners">
						<i class="fa-solid fa-droplet"></i> Drain
					</button>
				</div>

				<span>
					<button class="btn btn-sm btn-outline-danger" onclick="app.codeland.worker.killZombies()">
						<center>
							<i class="fa-solid fa-biohazard"></i><br />
							Kill Zombies
						</center>
					</button>
				</span>

			</div>
		
		</div>
	</div>

	<div class="col-md-4">
		<div class="card shadow-lg">
			<div class="card-header">
				<i class="fa-solid fa-server"></i>
				Available
			</div>
			<div class="card-header actionMessage" style="display:none"></div>

				<ul class="list-group ist-group-flush">
					<li id="runner-{{name}}" jq-repeat="runnerAvailable" jq-index-key="name" class="list-group-item list-group-item-primary" style="display:none">
						<button class="btn btn-sm btn-danger float-right" onclick="app.codeland.kill('{{name}}', ()=>{})">
							<i class="fa-solid fa-power-off"></i>
						</button>
						{{name}}
					</li>
				</ul>

		</div>
	</div>

	<div class="col-md-4">
		<div class="card shadow-lg">
			<div class="card-header">
				<i class="fa-solid fa-computer"></i>
				In use
			</div>
			<div class="card-header actionMessage" style="display:none"></div>

				<ul class="list-group">
					<li id="runner-{{name}}" jq-repeat="runnerInUse" jq-index-key="name" class="list-group-item list-group-item-warning" style="display:none">
						<button class="btn btn-sm btn-danger float-right" onclick="app.codeland.kill('{{name}}', ()=>{})">
							<i class="fa-solid fa-power-off"></i>
						</button>
						<span>{{name}}</span> <br />
						<span>{{lastStatus.status}} - <b>{{{info}}}</b></span>
						{{error}}
					</li>
				</ul>

		</div>

		<br />

		<div id="persistent-card" class="card shadow-lg">
			<div class="card-header">
				<i class="fa-solid fa-box-archive"></i>
				Persistent Runners
				<button class="btn btn-sm btn-outline-success float-right" onclick="createPersistent()">
					<i class="fa-solid fa-plus"></i>
				</button>
			</div>
			<div class="card-header actionMessage" style="display:none"></div>
			<ul class="list-group list-group-flush">
				<li id="runner-{{name}}" jq-repeat="persistentRunners" jq-index-key="name" class="list-group-item" style="display:none">
					<div class="d-flex w-100 justify-content-between">
						<b>{{name}}</b>
						<span class="badge badge-secondary">{{status}}</span>
					</div>
					<small>Worker: <b>{{worker}}</b></small>
					<div class="btn-group btn-group-sm mt-1">
						<button class="btn btn-outline-warning btn-sm" onclick="stopPersistent('{{name}}')" title="Stop">
							<i class="fa-solid fa-stop"></i>
						</button>
						<button class="btn btn-outline-primary btn-sm" onclick="migratePersistent('{{name}}')" title="Migrate">
							<i class="fa-solid fa-right-left"></i>
						</button>
					</div>
				</li>
			</ul>
		</div>

		<br />

		<div class="card shadow-lg">
			<div class="card-header">
				<i class="fa-solid fa-clock-rotate-left"></i>
				Runner History
			</div>
			<div class="card-header actionMessage" style="display:none"></div>
			<div class="card-body">
				<ul class="list-group">
					<li id="runner-{{name}}" jq-repeat="runnerHistory" jq-index-key="when" class="list-group-item list-group-item-{{okLabel}}" style="display:none">
						<div class="d-flex w-100 justify-content-between">
							<small class="text-truncate" style="max-width: 60%" title="{{runner}}">{{runner}}</small>
							<small>{{whenAgo}}</small>
						</div>
						<small>exit: {{exit}} &middot; {{duration}}ms</small>
					</li>
				</ul>
			</div>
		</div>
		
		<br />

		<div class="card shadow-lg">
			<div class="card-header">
				<i class="fa-solid fa-triangle-exclamation"></i>
				Errors
			</div>
			<div class="card-header actionMessage" style="display:none"></div>
				<ul class="list-group">
					<li id="runner-{{name}}" jq-repeat="errors" class="list-group-item list-group-item-danger" style="display:none">
						<h6 class="card-title">{{topic}}</h6>
						<p>
							{{runner.name}}
							{{error}}
							
						</p>
					</li>
				</ul>
		</div>

	</div>
</div>
<%- include('bottom') %>
