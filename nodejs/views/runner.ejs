<!-- Browse and edit files on the current runner (GET/POST/DELETE
     /runner/:runner/files*). The editor is the same Ace instance the main
     playground uses, so files get real syntax highlighting by extension. -->
<div class="modal" id="filesModal" tabindex="-1" role="dialog" aria-hidden="true">
	<div class="modal-dialog modal-lg" role="document">
		<div class="modal-content" style="height: 70vh;">
			<div class="modal-header">
				<h5 class="modal-title">
					<i class="fa-solid fa-folder-open"></i>
