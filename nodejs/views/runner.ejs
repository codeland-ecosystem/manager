<script type="text/javascript">
var editor;
var currentLanguage = 'sh';
var currentKeyboard = 'sublime';
var currentTimeout = 30;
var termTTY;
var ttyStarted = false;
var resultsTerm;
var codelandGUIonResult = false;
var isRunning = false;
var currentRunXHR = null;
var runToken = 0;

const STORAGE_KEY = 'codeland.playground.v1';

/*
	Ace's mode ids don't always match the language id we send to the backend
	(e.g. both "c" and "c_cpp" use ace's c_cpp mode). Only listed where they
	differ from the language id itself.
*/
const aceModeMap = {
	c: 'c_cpp',
	golang: 'golang',
	brainfuck: 'text',
};

/*
	One working hello-world per language, loaded automatically the first time
	a language is picked into an empty buffer so the dropdown is never a dead
	end.
*/
const starterSnippets = {
	sh: 'echo "Hello, CodeLand!"\n',
	powershell: 'Write-Output "Hello, CodeLand!"\n',
	perl: 'print "Hello, CodeLand!\\n";\n',
	php: '<?php\necho "Hello, CodeLand!\\n";\n',
	javascript: 'console.log("Hello, CodeLand!");\n',
	typescript: 'const message: string = "Hello, CodeLand!";\nconsole.log(message);\n',
	python: 'print("Hello, CodeLand!")\n',
	lua: 'print("Hello, CodeLand!")\n',
	ruby: 'puts "Hello, CodeLand!"\n',
	r: 'cat("Hello, CodeLand!\\n")\n',
	java: 'public class code {\n    public static void main(String[] args) {\n        System.out.println("Hello, CodeLand!");\n    }\n}\n',
	scala: 'object code extends App {\n  println("Hello, CodeLand!")\n}\n',
	haskell: 'main :: IO ()\nmain = putStrLn "Hello, CodeLand!"\n',
	groovy: 'println "Hello, CodeLand!"\n',
	fortran: 'program hello\n    print *, "Hello, CodeLand!"\nend program hello\n',
	csharp: 'using System;\n\nclass Program {\n    static void Main() {\n        Console.WriteLine("Hello, CodeLand!");\n    }\n}\n',
	c: '#include <stdio.h>\n\nint main(void) {\n    printf("Hello, CodeLand!\\n");\n    return 0;\n}\n',
	c_cpp: '#include <iostream>\n\nint main() {\n    std::cout << "Hello, CodeLand!" << std::endl;\n    return 0;\n}\n',
	rust: 'fn main() {\n    println!("Hello, CodeLand!");\n}\n',
	golang: 'package main\n\nimport "fmt"\n\nfunc main() {\n    fmt.Println("Hello, CodeLand!")\n}\n',
	swift: 'print("Hello, CodeLand!")\n',
	markdown: '# Hello, CodeLand!\n\nThis is **Markdown**, rendered to HTML.\n',
	brainfuck: '++++++++[>++++[>++>+++>+++>+<<<<-]>+>+>->>+[<]<-]>>.>---.+++++++..+++.>>.<-.<.+++.------.--------.>>+.>++.',
};

function debounce(fn, wait){
	let t;
	return function(...args){
		clearTimeout(t);
		t = setTimeout(() => fn.apply(this, args), wait);
	};
}

function saveLocal(){
	try{
		localStorage.setItem(STORAGE_KEY, JSON.stringify({
			code: editor.getValue(),
			language: currentLanguage,
			keyboard: currentKeyboard,
		}));
	}catch(error){}
}

function loadLocal(){
	try{
		return JSON.parse(localStorage.getItem(STORAGE_KEY) || 'null');
	}catch(error){
		return null;
	}
}

function loadStarterSnippet(language){
	const snippet = starterSnippets[language];
	if(snippet) editor.setValue(snippet, -1);
}

/*
	Only auto-fill a starter snippet when the buffer is empty, so switching
	languages never clobbers code the user already wrote.
*/
function maybeLoadStarter(language){
	if(editor && !editor.getValue().trim()) loadStarterSnippet(language);
}

/*
	Collect the current run options (code/language/stdin/timeout) to send to
	the structured run endpoints.
*/
function currentOpts(){
	const opts = {
		code: editor.getValue(),
		language: currentLanguage,
	};
	const stdin = $('#stdinInput').val();
	if(stdin) opts.stdin = stdin;
	if(currentTimeout) opts.timeout = currentTimeout;
	return opts;
}

/*
	Render a structured run result (stdout/stderr/exit kept separate, instead
	of one base64 blob) into the results terminal.
*/
function displayResult(data){
	if(data.stdout){
		for(let line of data.stdout.split('\n')) resultsTerm.writeln(line);
	}
	if(data.stderr){
		resultsTerm.writeln('');
		resultsTerm.writeln('\x1b[31m--- stderr ---\x1b[0m');
		for(let line of data.stderr.split('\n')) resultsTerm.writeln('\x1b[31m' + line + '\x1b[0m');
	}
	resultsTerm.writeln('');
	const exitColor = data.exit === 0 ? '\x1b[32m' : '\x1b[31m';
	resultsTerm.writeln(`\x1b[2m[runner ${data.runner} · ${data.duration}ms · exit ${exitColor}${data.exit}\x1b[0m\x1b[2m]\x1b[0m`);
}

/*
	Parse the code from into what the runners wants
*/

/*
	Map the arguments from the URL hash to what functions will edit the
	correct part of the page
*/

function updateURL(key, value){
	let hash = new URLSearchParams(window.location.hash.replace(/^\#/, ''));
	hash.set(key, value);

	window.location.hash = hash.toString();
}

const urlMap = {
	language: updateLanguage,
	keyboard: updateKeybpard,
	code: updateCode
};

function parseHash(){
	for (const [key, value] of new URLSearchParams(window.location.hash.replace(/^\#/, ''))) {
		if(urlMap[key]) urlMap[key](value, false)
	}
}

/*
	Helper functions to update the DOM. Functions will be called via event,
	or other helper functions
*/

// Helper function to update drop down menus
function updateDropDown(value, $elememt){
	let text;
	$elememt.find('a.dropdown-item').each(function(index){
		let $this = $(this)
		if($this.attr('value') === value){
			$this.addClass('active');
			text = $this.html()
		}else{
			$this.removeClass('active')
		}
	});

	$($elememt.find('button.dropdown-toggle')[0]).html(text)

	return !!text;
}

function updateKeybpard(keyboard, appendURL=true){
	if(updateDropDown(keyboard, $codelandKeyboardSelect)){
		editor.setKeyboardHandler(`ace/keyboard/${keyboard}`);
		currentKeyboard = keyboard;
		if(appendURL) updateURL('keyboard', keyboard);
	}
}

function updateLanguage(language, appendURL=true){
	if(updateDropDown(language, $codelandLanguageSelect)){
		editor.getSession().setMode(`ace/mode/${aceModeMap[language] || language}`);
		currentLanguage = language;
		if(appendURL) updateURL('language', language);
		maybeLoadStarter(language);
	}
}

function updateTimeout(seconds, appendURL=true){
	if(updateDropDown(seconds, $codelandTimeoutSelect)){
		currentTimeout = seconds ? Number(seconds) : undefined;
	}
}

function updateCode(code, appendURL){
	code = atob(code)
	editor.setValue(code, -1)
}

// Used by the share button to set the URL hash
function setCode(code){
	code = btoa(code)
	updateURL('language', currentLanguage)
	updateURL('code', code)
}

function buildAce(elememt){
	editor = ace.edit(elememt);
	// ace.require('ace/ext/settings_menu').init(editor);
	ace.require("ace/ext/language_tools");
	// editor.$blockScrolling = Infinity;
	editor.setFontSize(16);
	editor.setTheme("ace/theme/monokai");
	editor.getSession().setMode("ace/mode/sh");
	editor.setKeyboardHandler("ace/keyboard/sublime");
	editor.setShowInvisibles(true);
	editor.setOptions({
		enableBasicAutocompletion: true,
		enableSnippets: true,
		enableLiveAutocompletion: true
	});

	return editor;
}

function showTerminalPlaceholder($element){
	$element.html(`
		<div class="d-flex align-items-center justify-content-center" style="height:100%;">
			<button id="openTerminalBtn" class="btn btn-outline-success">
				<i class="fa-solid fa-terminal"></i> Open Terminal
			</button>
		</div>
	`);
	$element.find('#openTerminalBtn').one('click', function(){
		startTtyTerminal($element);
	});
}

function startTtyTerminal($element){
	ttyStarted = true;
	$element.empty();
	app.util.actionMessage(
		`Loading terminal from remote runenr`,
		$element,
		'warning',
	);

	app.codeland.persistentRun('ttyd -W bash > ~/.TTYD 2>&1 & echo "done"', (err, data)=>{
		if(err){
			let message = (data && data.message) || err.message || err;
			return app.util.actionMessage(
				`Failed with: <b>${message}</b><br/> Refreshing may clear the error...`,
				$element,
				'danger',
			);
		}

		termTTY = new CLTerminalWs(
			$element.get(0),
			`wss://7681_${data.domain}/ws`,
			function(){
				// Clear aurrent actions message
				app.util.actionMessage(``, $element);
			},
		);
	});
}

function loadPersistentRunners(){
	app.codeland.listRegistry(function(err, data){
		if(err) return console.log('registry error', err, data);
		const $list = $('#persistentRunnerList');
		$list.empty();
		if(!data.runners || !data.runners.length){
			$list.append('<div class="text-muted small">No persistent runners</div>');
			return;
		}
		for(const r of data.runners){
			let $el = $('<div class="d-flex justify-content-between align-items-center mb-1">' +
				'<span class="small text-truncate" style="max-width: 150px" title="' + r.name + '">' + r.name + '</span>' +
				'<button class="btn btn-outline-success btn-sm" onclick="runOnPersistent(\'' + r.name + '\')">' +
				'<i class="fa-solid fa-play"></i></button>' +
				'</div>');
			$list.append($el);
		}
	});
}

function createPersistentRunner(){
	let name = prompt('Persistent runner name:');
	if(!name) return;
	let memLimit = prompt('Memory limit (e.g. 512M, 1G) [optional]:') || undefined;
	app.codeland.makePersistent({name, memLimit}, function(err, data){
		if(err) return alert((data && data.message) || err);
		alert('Created persistent runner: ' + data.runner + ' on ' + data.worker);
		loadPersistentRunners();
	});
}

function runOnPersistent(name){
	resultsTerm.clear()
	app.util.actionMessage(`Executing on persistent runner <b>${name}</b>...`, $('#codeland-results'), 'warning')
	app.codeland.callStructured(name, currentOpts(), (err, data)=>{
		if(err){
			let message = (data && data.message) || err.message || err;
			app.util.actionMessage(`Persistent runner failed: <b>${message}</b>`, $('#codeland-results'), 'danger')
			return;
		}
		app.util.actionMessage('', $('#codeland-results'))
		displayResult(data);
	});
}

/*
	Toggle the Run button between its idle ("Run") and in-flight ("Cancel")
	states. Everything in .clodelandSettings except the Run/Cancel button
	itself is hidden while running -- the button must stay clickable so a
	hung run can always be cancelled instead of leaving the tab stuck.
*/
function setRunningUI(running){
	isRunning = running;
	if(running){
		$editorSettings.not('#execute').hide();
	}else{
		$editorSettings.not('#execute').show();
	}
	const $btn = $('#execute');
	if(running){
		$btn.removeClass('btn-outline-success').addClass('btn-outline-danger')
			.html('<i class="fa-solid fa-stop"></i> Cancel');
	}else{
		$btn.removeClass('btn-outline-danger').addClass('btn-outline-success')
			.html('<i class="fa-solid fa-play"></i> Run');
	}
}

function startRun(){
	const myToken = ++runToken;
	resultsTerm.clear()
	setRunningUI(true);
	$spinner.show()
	app.util.actionMessage(`
		Executing...
		<div class="spinner-border float-right" role="status">
			<span class="sr-only">Loading...</span>
		</div>
	`, $('#codeland-results'), 'warning')

	const opts = currentOpts();
	const onDone = function(err, data){
		// A newer run (or an explicit cancel) already superseded this one --
		// ignore this stale completion instead of clobbering current state.
		if(myToken !== runToken) return;

		setRunningUI(false);
		$spinner.hide()

		if(err){
			let message = (data && data.message) || err.message || err;
			app.util.actionMessage(`Runner failed with error: <b>${message}</b>`, $('#codeland-results'), 'danger')
			return;
		}
		app.util.actionMessage('', $('#codeland-results'))
		displayResult(data);

		if(!codelandGUIonResult) $('#codeland-GUI-resrilt-spiner').show()

		$.scope.runInformation.update(data)
	};

	if($('#keepRunnerToggle').is(':checked')){
		currentRunXHR = app.codeland.sessionRunStructured(opts, onDone, function(xhr){ currentRunXHR = xhr; });
	}else{
		currentRunXHR = app.codeland.onceStructured(opts, onDone);
	}
}

function cancelRun(){
	runToken++; // invalidate the in-flight run's callback, if it ever lands
	if(currentRunXHR && currentRunXHR.abort) currentRunXHR.abort();
	currentRunXHR = null;

	setRunningUI(false);
	$spinner.hide()

	// Aborting only stops the client from waiting -- the shell command may
	// still be running on the runner. For "keep runner" mode that runner is
	// ours by name, so recycling it actually stops the command. A throwaway
	// run has no session runner to recycle (it pops and frees its own), so
	// cancelling it only unblocks the tab.
	if($('#keepRunnerToggle').is(':checked') && app.codeland.getRunner().name){
		app.codeland.kill(function(){});
	}

	app.util.actionMessage('Cancelled.', $('#codeland-results'), 'warning');
	resultsTerm.writeln('\x1b[33m[cancelled]\x1b[0m');
}

$(document).ready(function(){
	/*
		Cache common DOM elements
	*/
	$editor = $('#editor')
	$editorSettings = $('.clodelandSettings');
	$spinner = $('#workerStatus');
	$results = $('#codeland-results');
	$codelandKeyboardSelect = $('#codelandKeyboardSelect');
	$codelandLanguageSelect = $('#codelandLanguageSelect');
	$codelandTimeoutSelect = $('#codelandTimeoutSelect');

	/*
		Create instances that need the DOM ready
	*/

	// The terminal is no longer opened automatically -- it burns a runner
	// before the user has asked for one. It only connects when explicitly
	// requested (the placeholder button, or Recycle if it was already open).
	showTerminalPlaceholder($('#codeland-tty'));

	resultsTerm = new CLTerminal(document.getElementById('codeland-results'));
	editor = buildAce($editor[0]);

	// A shared link (#code=...) always wins. Otherwise restore the last
	// local session so a refresh doesn't lose the buffer -- the hash is for
	// sharing, localStorage is for "what was I doing."
	const hashParams = new URLSearchParams(window.location.hash.replace(/^\#/, ''));
	if(hashParams.has('code')){
		parseHash();
	}else{
		const saved = loadLocal();
		if(saved){
			if(saved.language) updateLanguage(saved.language, false);
			if(saved.keyboard) updateKeybpard(saved.keyboard, false);
			if(saved.code) editor.setValue(saved.code, -1);
		}
	}
	if(!editor.getValue().trim()) loadStarterSnippet(currentLanguage);

	editor.on('change', debounce(saveLocal, 500));

	/*
		Set up event handlers
	*/
	$('#share').on('click', function(){
		setCode(editor.getValue());
		const url = window.location.href;
		const copied = function(){
			app.util.actionMessage('Link copied to clipboard!', $('#codeland-results'), 'success');
		};
		const fallback = function(){
			app.util.actionMessage(`Share link: <code>${url}</code>`, $('#codeland-results'), 'info');
		};
		if(navigator.clipboard && navigator.clipboard.writeText){
			navigator.clipboard.writeText(url).then(copied, fallback);
		}else{
			fallback();
		}
	});

	$('#execute').on('click', function(){
		if(isRunning){
			cancelRun();
		}else{
			startRun();
		}
	});

	$codelandKeyboardSelect.on('click', 'a.dropdown-item', function(event){
		updateKeybpard($(this).attr('value'))
	});

	$codelandLanguageSelect.on('click', 'a.dropdown-item', function(event){
		updateLanguage($(this).attr('value'))
	});

	$codelandTimeoutSelect.on('click', 'a.dropdown-item', function(event){
		updateTimeout($(this).attr('value'))
	});
	// Initialize the timeout dropdown label/active state to match currentTimeout.
	updateTimeout(String(currentTimeout));

	$('#runnerInfo').on('click', function(event){
		app.codeland.info(function(err, data){
			if(err) return console.log('info error', err, data)
			$.scope.runInformation.update({runner: name, ...data});
		});
	})

	// Populate the persistent-runner list in the dropdown when opened.
	loadPersistentRunners();

	$('#previewPort').on('click', function(event){
		let runner = app.codeland.getRunner();
		if(!runner.name){
			return app.util.actionMessage(
				`Run something first to get a runner.`,
				$('#codeland-results'),
				'warning',
			);
		}
		let port = prompt('Port to preview (e.g. 8080):');
		if(!port) return;
		port = port.trim();
		if(!/^\d+$/.test(port)){
			return alert('Port must be a number');
		}
		// The nginx proxy routes <port>_<runner>.<domain> to the runner's port.
		// runner.domain already includes the runner name prefix.
		let url = `${location.protocol}//${port}_${runner.domain}`;
		window.open(url, '_blank');
	});

	$('#runnerRecycle').on('click', function(event){
		if(termTTY) try{
			// https://github.com/xtermjs/xterm.js/issues/4757
			termTTY.dispose();
		}catch(error){}

		app.codeland.kill(function(){
			if(ttyStarted){
				app.util.actionMessage(`Getting new runner...`, $('#codeland-tty'), 'warning');
				startTtyTerminal($('#codeland-tty'));
			}else{
				showTerminalPlaceholder($('#codeland-tty'));
			}
			app.util.actionMessage(`Runner recycled.`, $('#codeland-results'), 'success');
		});
	});

	$('button.codeland-GUI').on('click', function(event){
		codelandGUIonResult = !codelandGUIonResult
		$('.codeland-GUI').toggle(function(){
			if(termTTY) termTTY.fit()
			resultsTerm.fit()
		});
	});

	/*
		pre-load the runner info info with spinners until its clicked on
	*/

	let loadingHTML = `
	<div class="spinner-border text-warning spinner-border-sm" role="status">
		<span class="sr-only">Loading...</span>
	</div>
	Loading...
	`
	$.scope.runInformation.update({
		runner: loadingHTML,
		duration: loadingHTML,
		domain: loadingHTML,
		ip: loadingHTML,
		rx: loadingHTML,
		tx: loadingHTML,
		total: loadingHTML,
		link: loadingHTML,
		kmem: loadingHTML,
		memory: loadingHTML,
	});

});
</script>
