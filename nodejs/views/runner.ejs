			</div>

			<!-- Directory listing view -->
			<div id="filesBrowseView" class="files-view" style="height: 100%; min-height: 0;">
				<div class="modal-body pb-0">
					<nav aria-label="breadcrumb" class="mb-1">
						<ol class="breadcrumb mb-0 py-1 px-2" id="filesBreadcrumb" style="background: transparent;"></ol>
					</nav>
					<div class="input-group input-group-sm mb-2">
						<div class="input-group-prepend">
							<button id="filesUp" class="btn btn-outline-secondary" title="Up one directory">
								<i class="fa-solid fa-level-up-alt"></i>
							</button>
						</div>
						<input type="text" id="filesPath" class="form-control" value="/tmp">
						<div class="input-group-append">
							<button id="filesGo" class="btn btn-outline-secondary">Go</button>
						</div>
					</div>
				</div>
				<div class="modal-body pt-0" style="flex: 1 1 auto; overflow-y: auto; min-height: 0;">
					<div id="filesListStatus" class="text-muted small"></div>
					<ul class="list-group list-group-flush" id="filesList"></ul>
				</div>
				<div class="modal-footer">
					<button id="filesNewFolder" class="btn btn-outline-secondary btn-sm">
						<i class="fa-solid fa-folder-plus"></i> New folder
					</button>
					<button id="filesNew" class="btn btn-outline-success btn-sm">
						<i class="fa-solid fa-file-circle-plus"></i> New file
					</button>
					<button id="filesUploadBtn" class="btn btn-outline-primary btn-sm">
						<i class="fa-solid fa-upload"></i> Upload
					</button>
					<input type="file" id="filesUploadInput" style="display:none">
