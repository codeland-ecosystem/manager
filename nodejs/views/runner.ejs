			<!-- File editor view (shown instead of the listing while a file is open) -->
			<div id="filesEditView" class="files-view" style="height: 100%; min-height: 0; display: none;">
				<div class="modal-body pb-0">
					<button id="filesEditBack" class="btn btn-outline-secondary btn-sm mb-2">
						<i class="fa-solid fa-arrow-left"></i> Back
					</button>
					<code id="filesEditPath"></code>
				</div>
				<div class="modal-body pt-0" style="flex: 1 1 auto; min-height: 0;">
					<div id="filesEditAce" style="height: 100%; font-size: 13px;"></div>
				</div>
				<div class="modal-footer">
					<div id="filesEditStatus" class="small mr-auto" style="display:none;"></div>
					<button id="filesEditSave" class="btn btn-success btn-sm">
						<i class="fa-solid fa-floppy-disk"></i> Save
					</button>
