</div>

<script type="text/javascript">
(function(){
	let filesCurrentDir = '/tmp';
	let filesEditingPath = null;
	let filesCurrentEntries = [];
	let filesEditor = null;

	function filesNormalizePath(path){
		const parts = path.split('/').filter(Boolean);
		const stack = [];
		for(const part of parts){
			if(part === '.') continue;
			if(part === '..') stack.pop();
			else stack.push(part);
		}
		return '/' + stack.join('/');
	}

	function filesJoin(dir, name){
		return filesNormalizePath(dir + '/' + name);
	}

	function filesShowBrowse(){
		filesEditingPath = null;
		$('#filesEditView').hide();
		$('#filesBrowseView').show();
	}

	/*
		Status line in the edit view's footer -- used for both the transient
		"Saved!" success and any read/write error, instead of alert().
	*/
	function filesEditStatus(message, type){
		$('#filesEditStatus')
			.removeClass('text-success text-danger')
			.addClass(type === 'danger' ? 'text-danger' : 'text-success')
			.stop(true)
			.text(message)
			.show()
			.delay(type === 'danger' ? 4000 : 1500)
			.fadeOut();
	}

	/*
		Built lazily on first use -- the browse view is what's shown by
		default, so there's no reason to pay Ace's init cost until a file is
		actually opened.
	*/
	function filesGetEditor(){
		if(filesEditor) return filesEditor;
		filesEditor = ace.edit('filesEditAce');
		filesEditor.setTheme('ace/theme/monokai');
		filesEditor.setFontSize(13);
		return filesEditor;
	}

	// modelist maps a filename to the right ace/mode/* by extension. This
	// build of ace.js only bundles its core -- ace.require() (used for
	// ace/ext/language_tools above) only resolves modules already loaded,
	// so it silently hands back undefined for anything not already on the
	// page. ace.config.loadModule is the one that actually fetches a
	// sibling ext-*.js on demand (the same mechanism setMode()/setTheme()
	// already use for modes/themes).
	function filesSetModeForPath(path){
		const editor = filesGetEditor();
		ace.config.loadModule('ace/ext/modelist', function(modelist){
			editor.getSession().setMode(modelist.getModeForPath(path).mode);
		});
	}

	function filesShowEdit(path){
		filesEditingPath = path;
		$('#filesEditPath').text(path);
		$('#filesEditStatus').hide();
		$('#filesBrowseView').hide();
		$('#filesEditView').show();
		filesSetModeForPath(path);
		// Ace only measures its container correctly once it's visible.
		setTimeout(function(){ filesGetEditor().resize(); }, 0);
	}

	function filesRenderBreadcrumbs(dir){
		const $bc = $('#filesBreadcrumb').empty();
		const parts = dir.split('/').filter(Boolean);

		const $root = $('<li class="breadcrumb-item"><i class="fa-solid fa-server"></i></li>');
		if(parts.length){
			$root.css('cursor', 'pointer').on('click', function(){ filesLoad('/'); });
		}else{
			$root.addClass('active');
		}
		$bc.append($root);

		let built = '';
		parts.forEach(function(part, idx){
			built = filesJoin(built, part);
			const target = built;
			const $li = $('<li class="breadcrumb-item"></li>').text(part);
			if(idx < parts.length - 1){
				$li.css('cursor', 'pointer').on('click', function(){ filesLoad(target); });
			}else{
				$li.addClass('active');
			}
			$bc.append($li);
		});
	}

	function filesLoad(dir){
		const runner = app.codeland.getRunner();
		if(!runner.name) return;

		dir = filesNormalizePath(dir);
		filesCurrentDir = dir;
		$('#filesPath').val(dir);
		filesRenderBreadcrumbs(dir);
		$('#filesList').empty();
		$('#filesListStatus').text('Loading...');

		app.codeland.listFiles(runner.name, dir, function(err, data){
			if(err){
				$('#filesListStatus').text((data && data.message) || err.message || err);
				return;
			}
			$('#filesListStatus').text('');

			const entries = (data.files || []).filter(f => f.name !== '.' && f.name !== '..');
			filesCurrentEntries = entries;
			if(!entries.length){
				$('#filesListStatus').text('Empty directory.');
			}

			// Sort directories first, then alphabetically.
			entries.sort((a, b) => (a.type === b.type) ? a.name.localeCompare(b.name) : (a.type === 'dir' ? -1 : 1));

			for(const entry of entries){
				const path = filesJoin(dir, entry.name);
				const icon = entry.type === 'dir' ? 'fa-folder text-warning' : 'fa-file text-light';
				const sizeLabel = entry.type === 'dir' ? '' : `<span class="text-muted small mr-2">${entry.size} B</span>`;
				const $row = $(`<li class="list-group-item list-group-item-action d-flex justify-content-between align-items-center" style="cursor:pointer;">
					<span class="text-truncate"><i class="fa-solid ${icon}"></i> ${$('<div>').text(entry.name).html()}</span>
					<span class="d-flex align-items-center flex-shrink-0">
						${sizeLabel}
						<button class="btn btn-sm btn-outline-secondary py-0 px-1 mr-1 files-rename" title="Rename"><i class="fa-solid fa-pen"></i></button>
						<button class="btn btn-sm btn-outline-danger py-0 px-1 files-delete" title="Delete"><i class="fa-solid fa-trash"></i></button>
					</span>
				</li>`);
				$row.on('click', function(){
					if(entry.type === 'dir') filesLoad(path);
					else filesOpen(path);
				});
				$row.find('.files-rename').on('click', function(e){
					e.stopPropagation();
					filesRename(dir, entry, path);
				});
				$row.find('.files-delete').on('click', function(e){
					e.stopPropagation();
					filesDelete(entry, path);
				});
				$('#filesList').append($row);
			}
		});
	}

	function filesRename(dir, entry, path){
		app.util.promptModal({title: 'Rename ' + entry.name, value: entry.name}, function(name){
			if(!name || name === entry.name) return;
			const dest = filesJoin(dir, name);
			const doRename = function(){
				app.codeland.renameFile(app.codeland.getRunner().name, path, dest, function(err, data){
					if(err){
						$('#filesListStatus').text((data && data.message) || err.message || err);
						return;
					}
					filesLoad(dir);
				});
			};
			if(filesCurrentEntries.some(e => e.name === name)){
				app.util.confirmModal(`"${name}" already exists in this directory. Overwrite it?`, doRename);
			}else{
				doRename();
			}
		});
	}

	function filesDelete(entry, path){
		const what = entry.type === 'dir' ? 'folder (and everything inside it)' : 'file';
		app.util.confirmModal(`Delete ${what} "${entry.name}"? This can't be undone.`, function(){
			app.codeland.deleteFile(app.codeland.getRunner().name, path, function(err, data){
				if(err){
					$('#filesListStatus').text((data && data.message) || err.message || err);
					return;
				}
				filesLoad(filesCurrentDir);
			});
		});
	}

	function filesOpen(path){
		const runner = app.codeland.getRunner();
		if(!runner.name) return;

		filesShowEdit(path);
		const editor = filesGetEditor();
		editor.setValue('', -1);
		editor.setReadOnly(true);

		app.codeland.readFile(runner.name, path, function(err, data){
			editor.setReadOnly(false);
			if(err){
				filesEditStatus((data && data.message) || err.message || err, 'danger');
				return;
			}
			editor.setValue(data.content || '', -1);
		});
	}

	function filesSave(){
		const runner = app.codeland.getRunner();
		if(!runner.name || !filesEditingPath) return;

		const content = filesGetEditor().getValue();
		app.codeland.writeFile(runner.name, filesEditingPath, content, function(err, data){
			if(err){
				filesEditStatus((data && data.message) || err.message || err, 'danger');
				return;
			}
			filesEditStatus('Saved!');
		});
	}

	$(document).ready(function(){
		$('#filesBtn').on('click', function(){
			const runner = app.codeland.getRunner();
			if(!runner.name){
				return app.util.actionMessage(
					`Run something first to get a runner.`,
					$('#codeland-results'),
					'warning',
				);
			}
			$('#filesRunnerName').text(runner.name);
			filesShowBrowse();
			filesLoad(filesCurrentDir);
			$('#filesModal').modal('show');
		});

		$('#filesGo').on('click', function(){ filesLoad($('#filesPath').val()); });
		$('#filesPath').on('keydown', function(e){ if(e.key === 'Enter') filesLoad($(this).val()); });
		$('#filesUp').on('click', function(){ filesLoad(filesJoin(filesCurrentDir, '..')); });

		$('#filesNewFolder').on('click', function(){
			app.util.promptModal({title: 'New folder name', placeholder: 'relative to ' + filesCurrentDir}, function(name){
				if(!name) return;
				app.codeland.makeDir(app.codeland.getRunner().name, filesJoin(filesCurrentDir, name), function(err, data){
					if(err){
						$('#filesListStatus').text((data && data.message) || err.message || err);
						return;
					}
					filesLoad(filesCurrentDir);
				});
			});
		});

		$('#filesNew').on('click', function(){
			app.util.promptModal({title: 'New file name', placeholder: 'relative to ' + filesCurrentDir}, function(name){
				if(!name) return;
				const openNew = function(){
					filesShowEdit(filesJoin(filesCurrentDir, name));
					filesGetEditor().setValue('', -1);
				};
				if(filesCurrentEntries.some(e => e.name === name && e.type !== 'dir')){
					app.util.confirmModal(`"${name}" already exists. Overwrite it?`, openNew);
				}else{
					openNew();
				}
			});
		});

		$('#filesUploadBtn').on('click', function(){ $('#filesUploadInput').trigger('click'); });
		$('#filesUploadInput').on('change', function(){
			const file = this.files && this.files[0];
			this.value = '';
			if(!file) return;
			const runner = app.codeland.getRunner();
			if(!runner.name) return;

			const reader = new FileReader();
			reader.onload = function(){
				const path = filesJoin(filesCurrentDir, file.name);
				app.codeland.writeFile(runner.name, path, reader.result, function(err, data){
					if(err){
						$('#filesListStatus').text((data && data.message) || err.message || err);
						return;
					}
					filesLoad(filesCurrentDir);
				});
			};
			// Text only -- writeFile round-trips content as a JSON string, so a
			// binary upload here would come out corrupted server-side.
			reader.readAsText(file);
		});

		$('#filesEditBack').on('click', filesShowBrowse);
		$('#filesEditSave').on('click', filesSave);
	});
})();
</script>

